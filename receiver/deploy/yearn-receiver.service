[Unit]
Description=yearn receiver (captures from the phone over Tailscale)
# After=tailscaled.service is advisory in a user unit (it cannot order against system
# units), so binding to the Tailscale IP at boot relies on Restart=on-failure + RestartSec.
After=tailscaled.service network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/Documents/personal/yearn/receiver/.venv/bin/yearn-receiver serve
Restart=on-failure
RestartSec=5
# Config errors exit 2; restarting cannot fix them.
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
