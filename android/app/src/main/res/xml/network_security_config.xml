<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      The receiver is plain http://<desktop>:8787, so cleartext HTTP is permitted here. Where the token may go
      is enforced in code, not by this file. The Tailscale address goes through ReceiverClient's TailnetDns
      guard, which only connects to Tailscale addresses (100.64.0.0/10, fd7a:115c:a1e0::/48) or loopback, for
      host names and IP literals alike, uses no proxy and follows no redirects. The optional home Wi-Fi address
      gets the same guard limited to private LAN ranges, and the desktop there must answer a token proof
      (GET /v1/prove) before the token is sent; on the home network itself the traffic is protected only by
      the Wi-Fi's own encryption.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
